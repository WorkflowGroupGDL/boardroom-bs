{
  "rootDir": "auth-system",
  "outputDir": "public",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "nodeVersion": "18",
  "cloudFunctions": {
    "nodejs": {
      "handler": "server.js",
      "handlerExport": "handler",
      "maxDuration": 10,
      "externalNodeModules": [
        "express",
        "cors",
        "jsonwebtoken",
        "dotenv",
        "@hubspot/api-client"
      ]
    }
  }
}
