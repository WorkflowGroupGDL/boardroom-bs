// Middleware de enrutamiento resiliente para Login y Registro
app.use(async (req, res, next) => {
  const isLogin = req.url.includes('login') || req.originalUrl.includes('login');
  const isRegister = req.url.includes('register') || req.originalUrl.includes('register');

  if (req.method === 'POST' && (isLogin || isRegister)) {
    if (isLogin) {
      // Ejecutar lógica de Login
      return handleLogin(req, res);
    } else if (isRegister) {
      // Ejecutar lógica de Registro
      return handleRegister(req, res);
    }
  }
  next();
});

